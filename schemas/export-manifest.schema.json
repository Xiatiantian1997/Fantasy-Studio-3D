{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fantasy Studio 3D export manifest v0.1",
  "description": "Draft metadata contract. Does not by itself prove Blender or ControlNet compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "subject_id",
    "pose_id",
    "frame",
    "status",
    "camera",
    "outputs"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "export_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,96}$"
    },
    "subject_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pose_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "frame": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "draft",
        "validated"
      ]
    },
    "demo_only": {
      "type": "boolean"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "projection",
        "width",
        "height",
        "pixel_origin",
        "image_x",
        "image_y",
        "coordinate_note",
        "clip_near",
        "clip_far",
        "world_unit_meters"
      ],
      "properties": {
        "camera_id": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "enum": [
            "perspective",
            "orthographic"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 64,
          "maximum": 16384
        },
        "pixel_origin": {
          "const": "top-left"
        },
        "image_x": {
          "const": "right"
        },
        "image_y": {
          "const": "down"
        },
        "coordinate_note": {
          "type": "string",
          "minLength": 10
        },
        "focal_length_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "orthographic_scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "clip_near": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Near clip in Blender scene units"
        },
        "clip_far": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Far clip in Blender scene units; must exceed clip_near"
        },
        "world_unit_meters": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Meters per Blender scene unit"
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rgb",
        "depth",
        "normal",
        "pose"
      ],
      "properties": {
        "rgb": {
          "$ref": "#/$defs/output"
        },
        "depth": {
          "allOf": [
            {
              "$ref": "#/$defs/output"
            },
            {
              "type": "object",
              "required": [
                "depth_kind",
                "positive_direction",
                "value_range",
                "units"
              ]
            }
          ]
        },
        "normal": {
          "allOf": [
            {
              "$ref": "#/$defs/output"
            },
            {
              "type": "object",
              "required": [
                "normal_space",
                "channel_order",
                "value_range",
                "color_space",
                "camera_forward_axis"
              ]
            }
          ]
        },
        "pose": {
          "$ref": "#/$defs/output"
        },
        "pose_preview": {
          "$ref": "#/$defs/output"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "encoding",
        "coordinate_space"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "encoding": {
          "type": "string",
          "minLength": 1
        },
        "coordinate_space": {
          "type": "string",
          "minLength": 1
        },
        "units": {
          "type": "string"
        },
        "layout": {
          "type": "string"
        },
        "depth_kind": {
          "enum": [
            "optical_axis_z",
            "radial_distance"
          ]
        },
        "positive_direction": {
          "enum": [
            "away_from_camera"
          ]
        },
        "value_range": {
          "type": "string",
          "minLength": 3
        },
        "normal_space": {
          "enum": [
            "camera",
            "world"
          ]
        },
        "channel_order": {
          "const": "XYZ"
        },
        "color_space": {
          "enum": [
            "linear"
          ]
        },
        "camera_forward_axis": {
          "enum": [
            "-Z",
            "+Z"
          ]
        }
      }
    }
  }
}
